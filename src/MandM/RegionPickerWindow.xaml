<Window x:Class="MandM.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#8806121C"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowState="Maximized">
  <Grid Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp"
        KeyDown="Root_KeyDown"
        Focusable="True">
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0"
            Background="#B00C2B40" BorderBrush="#A98BFF" BorderThickness="1"
            CornerRadius="10" Padding="18,10">
      <TextBlock Name="Hint" Text="Drag to select region — Esc to cancel"
                 Foreground="#E8F5FC" FontSize="14" FontWeight="SemiBold"/>
    </Border>
    <Rectangle Name="Selection"
               Stroke="#A98BFF" StrokeThickness="2"
               Fill="#33A98BFF"
               Visibility="Collapsed"
               IsHitTestVisible="False"/>
  </Grid>
</Window>
