<Window x:Class="MandM.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowState="Maximized">
  <Grid Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp"
        KeyDown="Root_KeyDown"
        Focusable="True">
    <TextBlock Name="Hint" Text="Drag to select region — Esc to cancel"
               Foreground="White" FontSize="16" FontWeight="SemiBold"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"/>
    <Rectangle Name="Selection"
               Stroke="#FFC4A35A" StrokeThickness="2"
               Fill="#33C4A35A"
               Visibility="Collapsed"
               IsHitTestVisible="False"/>
  </Grid>
</Window>
