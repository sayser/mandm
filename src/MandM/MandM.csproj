<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MandM</AssemblyName>
    <RootNamespace>MandM</RootNamespace>
    <Version>1.0.0</Version>
    <Product>MandM</Product>
    <Description>Self-buff tracker for Monsters &amp; Memories</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF single-file needs native libs extracted or HwndSubclass hits DllNotFoundException -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
