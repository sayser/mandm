<Window x:Class="MandM.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM Buff Overlay"
        Width="360" Height="260" MinWidth="180" MinHeight="56"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        LocationChanged="Overlay_BoundsChanged"
        SizeChanged="Overlay_BoundsChanged">
  <!-- Near-invisible hit target like EQDM buff overlay -->
  <Border Background="#C8081A28" BorderBrush="#56839C" BorderThickness="1" CornerRadius="14" Padding="8,6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Solid background so the full title strip is a drag hit-target -->
      <Border x:Name="DragHandle" Background="#33091F31" CornerRadius="8" Padding="6,4" Margin="0,0,0,6"
              Cursor="SizeAll">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="◈" FontSize="16" Foreground="#A98BFF" Margin="2,0,8,0"/>
            <TextBlock Text="BUFF TIMERS" FontWeight="Bold" Foreground="#E8F5FC"/>
          </StackPanel>
          <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Width="26" Height="26" Padding="0" FontSize="13"
                  Background="#78091F31" BorderBrush="#4F7891"
                  Cursor="Arrow"
                  ToolTip="Close buff overlay" Click="Close_Click"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ListBox Name="ListActive" Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,6"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" CornerRadius="8" Padding="10,8" MinHeight="44">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#F7FEFF"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                              <Setter Property="Foreground" Value="#E4C4D0"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TargetName}" FontSize="11"
                               TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#B7F4FF"/>
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                              <Setter Property="Foreground" Value="#C9A3B2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TargetName}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RemainingDisplay}"
                             FontWeight="Bold" FontSize="20" Margin="8,0,0,0"
                             VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#E7FBFF"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                            <Setter Property="Foreground" Value="#C48B9E"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="#FFBD57"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#B84A7A8C"/>
                    <Setter Property="BorderBrush" Value="#B7F4FF"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                        <Setter Property="Background" Value="#D2141018"/>
                        <Setter Property="BorderBrush" Value="#7A4456"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsWarning}" Value="True">
                        <Setter Property="BorderBrush" Value="#FFBD57"/>
                        <DataTrigger.EnterActions>
                          <BeginStoryboard x:Name="ExpiryPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0.4" To="1" Duration="0:0:0.38"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <StopStoryboard BeginStoryboardName="ExpiryPulse"/>
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Name="TxtEmpty" Text="No tracked buffs are currently active."
                   Foreground="#7899AD" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" IsHitTestVisible="False"/>
      </Grid>
    </Grid>
  </Border>
</Window>
