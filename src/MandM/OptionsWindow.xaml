<Window x:Class="MandM.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM — Options"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource ToolbarButton}" Content="Cancel" Width="90" Click="Cancel_Click"/>
      <Button Style="{StaticResource AccentButton}" Content="Save" Width="90" Margin="0" Click="Save_Click"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Capture regions" FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"
                 Text="Drag a rectangle over the in-game Abilities bar and Combat/chat window. Settings are stored beside MandM.exe."/>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Abilities" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="TxtAbilities" IsReadOnly="True" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="Set…" Margin="0"
                Padding="12,6" Click="SetAbilities_Click"/>
      </Grid>

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Combat Text" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="TxtCombat" IsReadOnly="True" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="Set…" Margin="0"
                Padding="12,6" Click="SetCombat_Click"/>
      </Grid>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="OCR interval (ms)" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="TxtInterval"/>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Settings file" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="TxtSettingsPath" IsReadOnly="True"
                 FontSize="11" Foreground="{StaticResource MutedBrush}"/>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
