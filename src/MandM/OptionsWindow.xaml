<Window x:Class="MandM.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM — Options"
        Height="760" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF061522">
  <Window.Resources>
    <Style x:Key="ColorSwatchButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Width="28" Height="28" CornerRadius="7"
                    Background="#32081420" BorderBrush="#355B73" BorderThickness="1" Padding="3">
              <Border x:Name="Swatch" CornerRadius="5"
                      Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                      BorderBrush="#1A000000" BorderThickness="1"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#57A99F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Ellipse Width="420" Height="240" Fill="#1239D3C2" HorizontalAlignment="Right"
             VerticalAlignment="Top" Margin="0,-120,-60,0" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
    </Ellipse>
    <DockPanel Margin="18">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="100" Click="Save_Click"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Capture regions -->
          <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="◉" FontSize="22" Foreground="#57A99F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="CAPTURE REGIONS" Style="{StaticResource SectionLabel}" FontSize="15"/>
                  <TextBlock Text="Add any named text windows — drag a rectangle on any monitor"
                             Foreground="#66879D" FontSize="10"/>
                </StackPanel>
              </StackPanel>

              <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                  <Button Content="Add" MinWidth="64" Padding="10,6" Margin="0,0,6,0" Click="AddRegion_Click"/>
                  <Button Content="Rename" MinWidth="72" Padding="10,6" Margin="0,0,6,0" Click="RenameRegion_Click"/>
                  <Button Content="Set…" MinWidth="64" Padding="10,6" Margin="0,0,6,0" Click="SetRegion_Click"/>
                  <Button Content="Remove" MinWidth="72" Padding="10,6" Click="RemoveRegion_Click"/>
                </StackPanel>
                <TextBlock Text="Named OCR rectangles used by buff cast / land / fade / warn lines"
                           Foreground="#66879D" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>

              <ListBox Name="ListRegions" Height="168" Margin="0,0,0,12"
                       Background="#61071F31" BorderBrush="#56839C"
                       DisplayMemberPath="ListDisplay"/>

              <TextBlock Text="OCR interval (ms)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtInterval" Margin="0,0,0,14" Width="160" HorizontalAlignment="Left"/>

              <TextBlock Text="Settings file" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtSettingsPath" IsReadOnly="True" FontSize="11" Foreground="#7899AD"/>
            </StackPanel>
          </Border>

          <!-- Spoken alerts (EQDM-style Windows voice) -->
          <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="🔊" FontSize="20" Foreground="#A98BFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="SPOKEN ALERTS" Style="{StaticResource SectionLabel}" FontSize="15"/>
                  <TextBlock Text="Windows natural voice for buff warn/fade and timer alarms (EQDM-style)"
                             Foreground="#66879D" FontSize="10"/>
                </StackPanel>
              </StackPanel>

              <TextBlock Text="VOICE" Style="{StaticResource DialogLabel}"/>
              <ComboBox Name="CmbVoice" Margin="0,0,0,10"
                        DisplayMemberPath="Label"
                        Foreground="#EDF7FF" Background="#A0092235" BorderBrush="#42677F"/>

              <Grid Margin="0,0,0,10">
                <TextBlock Text="VOLUME" Style="{StaticResource DialogLabel}" Margin="0"/>
                <TextBlock Name="TxtVoiceVolume" HorizontalAlignment="Right" Foreground="#C8E0EE" FontSize="11"/>
              </Grid>
              <Slider Name="SldVoiceVolume" Minimum="0" Maximum="100" TickFrequency="5"
                      IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

              <StackPanel Orientation="Horizontal">
                <Button Content="Preview voice" MinWidth="120" Padding="12,7" Click="PreviewVoice_Click"/>
              </StackPanel>
              <TextBlock Text="Per buff/timer: set Alert Output to Voice and enter custom spoken text."
                         Foreground="#66879D" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Mouse highlight (EQDM parity) -->
          <Border Style="{StaticResource GlassCard}" Padding="18,16">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="◎" FontSize="20" Foreground="#FF9B62" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="MOUSE HIGHLIGHT" Style="{StaticResource SectionLabel}" FontSize="15"/>
                    <TextBlock Text="Click-through ring around the cursor while MandM is running"
                               Foreground="#66879D" FontSize="10"/>
                  </StackPanel>
                </StackPanel>
                <CheckBox Name="ChkMouseEnabled" Content="Enable" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Foreground="#C8E0EE" FontSize="12" FontWeight="SemiBold"/>
              </Grid>

              <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <TextBlock Text="COLOR" Style="{StaticResource DialogLabel}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Border Name="SwatchPreview" Width="14" Height="14" CornerRadius="3"
                              BorderBrush="#A98BFF" BorderThickness="1" Margin="0,0,6,0"/>
                      <TextBlock Name="TxtColorName" Text="Orange" Foreground="#C8E0EE" FontSize="11"
                                 FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel Name="ColorSwatches" Margin="0,0,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hex" VerticalAlignment="Center" Foreground="#8BA9BD"
                               FontSize="11" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Name="TxtColorHex"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InnerCard}" Padding="10,8">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="SIZE" Style="{StaticResource DialogLabel}" Margin="0"/>
                      <TextBlock Name="TxtDiameter" HorizontalAlignment="Right" Foreground="#C8E0EE" FontSize="11"/>
                    </Grid>
                    <Slider Name="SldDiameter" Minimum="20" Maximum="120" TickFrequency="4"
                            IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="10,8">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="THICKNESS" Style="{StaticResource DialogLabel}" Margin="0"/>
                      <TextBlock Name="TxtThickness" HorizontalAlignment="Right" Foreground="#C8E0EE" FontSize="11"/>
                    </Grid>
                    <Slider Name="SldThickness" Minimum="1" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InnerCard}" Padding="10,8">
                  <StackPanel>
                    <CheckBox Name="ChkBlink" Content="Blink" Foreground="#C8E0EE"
                              FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,6,0,0" Name="BlinkSpeedPanel">
                      <TextBlock Text="SPEED" Style="{StaticResource DialogLabel}" Margin="0"/>
                      <TextBlock Name="TxtBlinkHz" HorizontalAlignment="Right" Foreground="#C8E0EE" FontSize="11"/>
                    </Grid>
                    <Slider Name="SldBlinkHz" Minimum="0.5" Maximum="6" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="10,8">
                  <StackPanel>
                    <CheckBox Name="ChkSecondRing" Content="Second circle" Foreground="#C8E0EE"
                              FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,6,0,0" Name="SecondSizePanel">
                      <TextBlock Text="OUTER SIZE" Style="{StaticResource DialogLabel}" Margin="0"/>
                      <TextBlock Name="TxtSecondDiameter" HorizontalAlignment="Right" Foreground="#C8E0EE" FontSize="11"/>
                    </Grid>
                    <Slider Name="SldSecondDiameter" Minimum="40" Maximum="200" TickFrequency="4"
                            IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
