<Window x:Class="MandM.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM — Options"
        Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF071624">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="100" Click="Save_Click"/>
    </StackPanel>

    <Border Style="{StaticResource GlassCard}" Padding="18,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="◉" FontSize="22" Foreground="#57A99F" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="CAPTURE REGIONS" Style="{StaticResource SectionLabel}" FontSize="15"/>
            <TextBlock Text="Drag rectangles over in-game Abilities and Combat Text windows"
                       Foreground="#66879D" FontSize="10"/>
          </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Abilities" Style="{StaticResource DialogLabel}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Name="TxtAbilities" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Set…" MinWidth="72" Padding="12,7" Click="SetAbilities_Click"/>

            <TextBlock Grid.Row="2" Text="Combat Text" Style="{StaticResource DialogLabel}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="TxtCombat" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Set…" MinWidth="72" Padding="12,7" Click="SetCombat_Click"/>
          </Grid>
        </Border>

        <TextBlock Text="OCR interval (ms)" Style="{StaticResource DialogLabel}"/>
        <TextBox Name="TxtInterval" Margin="0,0,0,14" Width="160" HorizontalAlignment="Left"/>

        <TextBlock Text="Settings file" Style="{StaticResource DialogLabel}"/>
        <TextBox Name="TxtSettingsPath" IsReadOnly="True" FontSize="11" Foreground="#7899AD"/>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
