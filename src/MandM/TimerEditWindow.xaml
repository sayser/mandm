<Window x:Class="MandM.TimerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Timer"
        Width="440"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF061522">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Test Alert" Width="100" Margin="0,0,8,0" Click="TestAlert_Click"/>
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90" Click="Save_Click"/>
    </StackPanel>

    <Border Style="{StaticResource GlassCard}" Padding="18,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="⏱" FontSize="22" Foreground="#2FD8C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="USER TIMER" Style="{StaticResource SectionLabel}" FontSize="15"/>
            <TextBlock Text="Name + duration — alert when the countdown hits zero"
                       Foreground="#66879D" FontSize="10"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="NAME" Style="{StaticResource DialogLabel}"/>
        <TextBox Name="TxtName" Margin="0,0,0,14" MinHeight="34"/>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="MINUTES" Style="{StaticResource DialogLabel}"/>
            <TextBox Name="TxtDurationMin" MinHeight="34"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="SECONDS" Style="{StaticResource DialogLabel}"/>
            <TextBox Name="TxtDurationSec" MinHeight="34"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="ALERT OUTPUT" Style="{StaticResource DialogLabel}"/>
        <ComboBox Name="CmbAlertMode" Margin="0,0,0,10"
                  SelectionChanged="AlertMode_Changed"
                  Foreground="#EDF7FF" Background="#A0092235" BorderBrush="#42677F"/>

        <StackPanel Name="PanelSound">
          <TextBlock Text="ALARM SOUND" Style="{StaticResource DialogLabel}"/>
          <ComboBox Name="CmbSound" IsEditable="True" Margin="0,0,0,6"
                    Foreground="#EDF7FF" Background="#A0092235" BorderBrush="#42677F"/>
        </StackPanel>

        <StackPanel Name="PanelVoice" Visibility="Collapsed">
          <TextBlock Text="VOICE TEXT" Style="{StaticResource DialogLabel}"/>
          <TextBox Name="TxtVoice" MinHeight="34"
                   ToolTip="Spoken when the timer ends. Empty uses “{name} finished”."/>
          <TextBlock Text="Voice is chosen in Options → Spoken alerts."
                     Foreground="#66879D" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
