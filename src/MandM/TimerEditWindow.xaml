<Window x:Class="MandM.TimerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Timer"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF061522">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90" Click="Save_Click"/>
    </StackPanel>

    <Border Style="{StaticResource GlassCard}" Padding="18,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="⏱" FontSize="22" Foreground="#2FD8C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="USER TIMER" Style="{StaticResource SectionLabel}" FontSize="15"/>
            <TextBlock Text="Name + duration — start/stop from the TIMER tab"
                       Foreground="#66879D" FontSize="10"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="NAME" Style="{StaticResource DialogLabel}"/>
        <TextBox Name="TxtName" Margin="0,0,0,12"/>

        <TextBlock Text="DURATION (MINUTES)" Style="{StaticResource DialogLabel}"/>
        <TextBox Name="TxtDurationMin" Width="160" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
