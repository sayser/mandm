<Window x:Class="MandM.BuffEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Buff"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource ToolbarButton}" Content="Test Sound" Width="100" Click="TestSound_Click"/>
      <Button Style="{StaticResource ToolbarButton}" Content="Cancel" Width="90" Click="Cancel_Click"/>
      <Button Style="{StaticResource AccentButton}" Content="Save" Width="90" Margin="0" Click="Save_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <CheckBox Name="ChkEnabled" Content="Enabled" Margin="0,0,0,10"/>

        <Label Content="Name"/>
        <TextBox Name="TxtName" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Duration (minutes)"/>
            <TextBox Name="TxtDurationMin"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Warn time (seconds)"/>
            <TextBox Name="TxtWarnSec"/>
          </StackPanel>
        </Grid>

        <Label Content="Cast text (optional match)"/>
        <TextBox Name="TxtCast" Margin="0,0,0,10"/>

        <Label Content="Land text (starts timer)"/>
        <TextBox Name="TxtLand" Margin="0,0,0,10"/>

        <Label Content="Fade text (clears timer)"/>
        <TextBox Name="TxtFade" Margin="0,0,0,10"/>

        <Label Content="Alarm sound"/>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Browse…"
                  Margin="8,0,0,0" Padding="10,4" Click="BrowseSound_Click"/>
          <ComboBox Name="CmbSound" IsEditable="True"/>
        </DockPanel>
        <TextBlock Text="Built-ins: Beep, Asterisk, Exclamation, Hand, Question — or pick a .wav file."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
