<Window x:Class="MandM.BuffEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Buff"
        Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF071624">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Test Sound" Width="110" Margin="0,0,8,0" Click="TestSound_Click"/>
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90" Click="Save_Click"/>
    </StackPanel>

    <Border Style="{StaticResource GlassCard}" Padding="18,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="◈" FontSize="22" Foreground="#A98BFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="BUFF DEFINITION" Style="{StaticResource SectionLabel}" FontSize="15"/>
              <TextBlock Text="Land text starts the timer · Fade text clears it · Warn plays alarm"
                         Foreground="#66879D" FontSize="10"/>
            </StackPanel>
          </StackPanel>

          <CheckBox Name="ChkEnabled" Content="Enabled" Margin="0,0,0,12"/>

          <TextBlock Text="NAME" Style="{StaticResource DialogLabel}"/>
          <TextBox Name="TxtName" Margin="0,0,0,12"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="DURATION (MINUTES)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtDurationMin"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="WARN TIME (SECONDS)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtWarnSec"/>
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel>
              <TextBlock Text="COMBAT TEXT MATCHES" Style="{StaticResource MetricLabel}" Margin="0,0,0,10"/>

              <TextBlock Text="CAST TEXT (OPTIONAL)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtCast" Margin="0,0,0,10"/>

              <TextBlock Text="LAND TEXT (STARTS TIMER)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtLand" Margin="0,0,0,10"/>

              <TextBlock Text="FADE TEXT (CLEARS TIMER)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtFade"/>
            </StackPanel>
          </Border>

          <TextBlock Text="ALARM SOUND" Style="{StaticResource DialogLabel}"/>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Padding="12,7"
                    Click="BrowseSound_Click"/>
            <ComboBox Name="CmbSound" IsEditable="True"/>
          </DockPanel>
          <TextBlock Text="Built-ins: Beep, Asterisk, Exclamation, Hand, Question — or pick a .wav file."
                     Foreground="#66879D" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
