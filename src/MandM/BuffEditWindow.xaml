<Window x:Class="MandM.BuffEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Buff"
        Height="720" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF061522">
  <Grid>
    <Ellipse Width="380" Height="220" Fill="#157C5CFC" HorizontalAlignment="Left"
             VerticalAlignment="Top" Margin="-80,-100,0,0" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
    </Ellipse>
    <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Test Sound" Width="110" Margin="0,0,8,0" Click="TestSound_Click"/>
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90" Click="Save_Click"/>
    </StackPanel>

    <Border Style="{StaticResource GlassCard}" Padding="18,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="◈" FontSize="22" Foreground="#A98BFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="BUFF DEFINITION" Style="{StaticResource SectionLabel}" FontSize="15"/>
              <TextBlock Text="Land starts timer · Fade clears · Warn text alarms early · each line picks a region"
                         Foreground="#66879D" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>

          <CheckBox Name="ChkEnabled" Content="Enabled" Margin="0,0,0,12"/>

          <TextBlock Text="NAME" Style="{StaticResource DialogLabel}"/>
          <TextBox Name="TxtName" Margin="0,0,0,12"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="DURATION (MINUTES)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtDurationMin"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="WARN TIME (SECONDS)" Style="{StaticResource DialogLabel}"/>
              <TextBox Name="TxtWarnSec"/>
              <TextBlock Text="Used only when warn text below is empty"
                         Foreground="#66879D" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel>
              <TextBlock Text="TEXT MATCHES + CAPTURE REGION" Style="{StaticResource MetricLabel}" Margin="0,0,0,10"/>

              <TextBlock Text="CAST TEXT (OPTIONAL)" Style="{StaticResource DialogLabel}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtCast"/>
                <ComboBox Grid.Column="2" Name="CmbCastRegion"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
              </Grid>

              <TextBlock Text="LAND TEXT (STARTS TIMER)" Style="{StaticResource DialogLabel}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtLand"/>
                <ComboBox Grid.Column="2" Name="CmbLandRegion"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
              </Grid>

              <TextBlock Text="FADE TEXT (CLEARS TIMER)" Style="{StaticResource DialogLabel}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtFade"/>
                <ComboBox Grid.Column="2" Name="CmbFadeRegion"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
              </Grid>

              <TextBlock Text="WARN TEXT (OPTIONAL — ALARMS IMMEDIATELY)" Style="{StaticResource DialogLabel}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtWarn"/>
                <ComboBox Grid.Column="2" Name="CmbWarnRegion"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
              </Grid>
              <TextBlock Text="Leave warn text empty to keep the time-based warn above."
                         Foreground="#66879D" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <TextBlock Text="ALARM SOUND" Style="{StaticResource DialogLabel}"/>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Padding="12,7"
                    Click="BrowseSound_Click"/>
            <ComboBox Name="CmbSound" IsEditable="True"
                      Foreground="#EDF7FF" Background="#A0092235"
                      BorderBrush="#42677F"/>
          </DockPanel>
          <TextBlock Text="Built-ins: Beep, Asterisk, Exclamation, Hand, Question — or pick a .wav file."
                     Foreground="#66879D" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    </DockPanel>
  </Grid>
</Window>
