<Application x:Class="MandM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
  <Application.Resources>
    <!-- EQDM-inspired palette (style only) -->
    <Color x:Key="WindowBgColor">#061522</Color>
    <Color x:Key="SurfaceRaisedColor">#18233B</Color>
    <Color x:Key="BorderColor">#56839C</Color>
    <Color x:Key="BorderMutedColor">#42677F</Color>
    <Color x:Key="PrimaryColor">#7C5CFC</Color>
    <Color x:Key="PrimaryLiteColor">#A98BFF</Color>
    <Color x:Key="TextColor">#F5F7FF</Color>
    <Color x:Key="MutedTextColor">#7899AD</Color>
    <Color x:Key="TealAccentColor">#2EE6C8</Color>
    <Color x:Key="WarnAccentColor">#FFBD57</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderMutedBrush" Color="{StaticResource BorderMutedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLiteBrush" Color="{StaticResource PrimaryLiteColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccentColor}"/>
    <SolidColorBrush x:Key="WarnAccentBrush" Color="{StaticResource WarnAccentColor}"/>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#071522" Offset="0"/>
      <GradientStop Color="#08263A" Offset="0.46"/>
      <GradientStop Color="#081A2B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#88092236" Offset="0"/>
      <GradientStop Color="#780B3349" Offset="0.48"/>
      <GradientStop Color="#88092033" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#72082235" Offset="0"/>
      <GradientStop Color="#620A3147" Offset="0.48"/>
      <GradientStop Color="#72071D30" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GlassPanelBrush}"/>
      <Setter Property="BorderBrush" Value="#56839C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.32" Color="#001018"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InnerCard" TargetType="Border">
      <Setter Property="Background" Value="#B00C2B40"/>
      <Setter Property="BorderBrush" Value="#416A83"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B8D4E5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#89A9C1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <Style x:Key="DialogLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8BA9BD"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowGradient}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8F8FF"/>
      <Setter Property="Background" Value="#A0092235"/>
      <Setter Property="BorderBrush" Value="#42677F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#B0153A50"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#57A99F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#684CC0"/>
      <Setter Property="BorderBrush" Value="#A98BFF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="Background" Value="#78091F31"/>
      <Setter Property="BorderBrush" Value="#4F7891"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PanelActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#C8DCE8"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="IconBox" Width="26" Height="26" CornerRadius="7"
                        Background="#33081420" BorderBrush="#355B73" BorderThickness="1"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock x:Name="IconGlyph" Text="{TemplateBinding Tag}"
                             FontFamily="Segoe UI Symbol" FontSize="12"
                             Foreground="#C8DCE8" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#33153A50"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5A7F96"/>
                <Setter Property="Foreground" Value="#E8F5FC"/>
                <Setter TargetName="IconGlyph" Property="Foreground" Value="#E8F5FC"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#55301A52"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9A6FF"/>
                <Setter Property="Foreground" Value="#D8C2FF"/>
                <Setter TargetName="IconBox" Property="Background" Value="#664B2FA8"/>
                <Setter TargetName="IconBox" Property="BorderBrush" Value="#A98BFF"/>
                <Setter TargetName="IconGlyph" Property="Foreground" Value="#D8C2FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BuffInput" TargetType="TextBox">
      <Setter Property="Foreground" Value="#EDF7FF"/>
      <Setter Property="Background" Value="#A0092235"/>
      <Setter Property="BorderBrush" Value="#42677F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#9A78FF"/>
      <Setter Property="SelectionBrush" Value="#684CC0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BuffInput}"/>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C8E0EE"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EDF7FF"/>
      <Setter Property="Background" Value="#A0092235"/>
      <Setter Property="BorderBrush" Value="#42677F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#61071F31"/>
      <Setter Property="BorderBrush" Value="#355B73"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
  </Application.Resources>
</Application>
