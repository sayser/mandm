<Window x:Class="MandM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM — Buff Tracker"
        Height="560" Width="720"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="MandM" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                   Margin="0,0,16,0"/>
        <Button Style="{StaticResource ToolbarButton}" Content="Overlay" Click="Overlay_Click" Name="BtnOverlay"/>
        <Button Style="{StaticResource ToolbarButton}" Content="Options" Click="Options_Click"/>
        <Button Style="{StaticResource AccentButton}" Content="Add Buff" Click="AddBuff_Click"/>
        <Button Style="{StaticResource ToolbarButton}" Content="Check Updates" Click="Updates_Click"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Name="TxtVersion" Foreground="{StaticResource MutedBrush}"
                 VerticalAlignment="Center" FontSize="11"/>
    </DockPanel>

    <StatusBar DockPanel.Dock="Bottom" Background="Transparent" Margin="0,10,0,0">
      <StatusBarItem>
        <TextBlock Name="TxtStatus" Foreground="{StaticResource MutedBrush}" Text="Ready"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Active buffs + definitions -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="ACTIVE BUFFS" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <ListBox Name="ListActive" Height="160" DockPanel.Dock="Top" Margin="0,0,0,14"
                 BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}"
                               Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}"
                               Background="#FF2A2A30" BorderThickness="0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RemainingDisplay}" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="14">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="TRACKED BUFFS" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ToolbarButton}" Content="Edit" Margin="0,0,6,0" Padding="10,4" Click="EditBuff_Click"/>
            <Button Style="{StaticResource ToolbarButton}" Content="Delete" Margin="0,0,6,0" Padding="10,4" Click="DeleteBuff_Click"/>
            <Button Style="{StaticResource ToolbarButton}" Content="Test Land" Margin="0" Padding="10,4" Click="TestLand_Click"/>
          </StackPanel>
        </DockPanel>

        <ListBox Name="ListBuffs" BorderThickness="1" DisplayMemberPath="Name"/>
      </DockPanel>

      <!-- Loaded abilities + OCR preview -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="LOADED ABILITIES (OCR)" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <ListBox Name="ListAbilities" Height="160" DockPanel.Dock="Top" Margin="0,0,0,14" BorderThickness="1"/>

        <TextBlock DockPanel.Dock="Top" Text="COMBAT TEXT PREVIEW" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <TextBox Name="TxtCombatPreview" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="11"
                 Background="{StaticResource PanelBrush}"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
