<Window x:Class="MandM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandM — Buff Tracker"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#061522">
  <Grid>
    <Grid.Background>
      <StaticResource ResourceKey="WindowGradient"/>
    </Grid.Background>

    <!-- EQDM nebula atmosphere -->
    <Ellipse Width="720" Height="390" Fill="#1239D3C2" HorizontalAlignment="Center"
             VerticalAlignment="Top" Margin="120,-250,0,0" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="620" Height="340" Fill="#157C5CFC" HorizontalAlignment="Right"
             VerticalAlignment="Top" Margin="0,-220,80,0" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="520" Height="280" Fill="#102EE6C8" HorizontalAlignment="Left"
             VerticalAlignment="Bottom" Margin="-80,0,0,-140" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
    </Ellipse>

    <DockPanel Margin="18">
      <!-- Branded command header (EQDM pill language) -->
      <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGlow}"
              BorderBrush="#56839C" BorderThickness="1" CornerRadius="22"
              Padding="10,8" Margin="0,0,0,14">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.35" Color="#001018"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,12,0"
                      Background="#8A071A28" BorderBrush="#5B879F" BorderThickness="1">
                <Border Width="36" Height="36" CornerRadius="9" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Background="#664B2FA8" BorderBrush="#A98BFF" BorderThickness="1">
                  <TextBlock Text="◈" FontSize="18" Foreground="#D8C2FF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MandM" FontSize="24" FontWeight="Light" Foreground="#E8F8FF"/>
                <TextBlock Text="MONSTERS  &amp;  MEMORIES  ·  SELF BUFF TRACKER"
                           Foreground="#8FDCD9" FontSize="11" FontWeight="SemiBold" Margin="1,1,0,0"/>
                <TextBlock Name="TxtVersion" Foreground="#7FA3B8" FontSize="10"
                           FontWeight="SemiBold" Margin="1,2,0,0"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Name="BtnOverlay" Style="{StaticResource HeaderActionButton}"
                      Content="Overlay: Off" Click="Overlay_Click"/>
              <Button Style="{StaticResource HeaderActionButton}" Content="Options" Click="Options_Click"/>
              <Button Style="{StaticResource HeaderActionButton}" Content="Updates" Click="Updates_Click" Margin="0"/>
            </StackPanel>
          </DockPanel>

          <!-- Status pills — MandM content, EQDM chrome -->
          <Border Grid.Row="2" Background="#BA081F31" BorderBrush="#4F7891"
                  BorderThickness="1" CornerRadius="16" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Name="OcrDot" Width="7" Height="7" Fill="#39E0CC" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="OCR" Style="{StaticResource MetricLabel}" FontSize="10"/>
                    <TextBlock Name="TxtOcrPill" Text="Ready" FontSize="12" FontWeight="SemiBold" Foreground="#E8F5FC"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusPill}">
                <StackPanel>
                  <TextBlock Text="Overlay" Style="{StaticResource MetricLabel}" FontSize="10"/>
                  <TextBlock Name="TxtOverlayPill" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#2ED9C7"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusPill}">
                <StackPanel>
                  <TextBlock Text="Cursor ring" Style="{StaticResource MetricLabel}" FontSize="10"/>
                  <TextBlock Name="TxtMousePill" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#89A9C1"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusPill}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Active buffs" Style="{StaticResource MetricLabel}" FontSize="10"/>
                  <TextBlock Name="TxtActivePill" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#D8C2FF"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Primary module nav (EQDM chrome, MandM modules) -->
          <Border Grid.Row="4" Background="#88071424" BorderBrush="#3D6178"
                  BorderThickness="1" CornerRadius="14" Padding="6,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <RadioButton Name="TabBuffs" Content="BUFFS" Tag="◈" GroupName="PrimaryModule"
                           Style="{StaticResource PrimaryModuleNavButton}" IsChecked="True"
                           Checked="ModuleTab_Checked"/>
              <RadioButton Name="TabTimers" Content="TIMER" Tag="⏱" GroupName="PrimaryModule"
                           Style="{StaticResource PrimaryModuleNavButton}" MinWidth="110"
                           Checked="ModuleTab_Checked"/>
              <RadioButton Name="TabOcr" Content="OCR" Tag="☰" GroupName="PrimaryModule"
                           Style="{StaticResource PrimaryModuleNavButton}" MinWidth="100"
                           Checked="ModuleTab_Checked"/>
              <RadioButton Name="TabDamage" Content="DAMAGE TRACKER" Tag="⚔" GroupName="PrimaryModule"
                           Style="{StaticResource PrimaryModuleNavButton}" MinWidth="160"
                           Checked="ModuleTab_Checked"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Status -->
      <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="4,0">
        <TextBlock Name="TxtStatus" Foreground="#66879D" FontSize="11" Text="Ready"/>
      </Border>

      <Grid>
        <!-- BUFFS — ACTIVE NOW left, TRACKED BUFFS right -->
        <Grid Name="PanelBuffs">
          <Border Style="{StaticResource GlassCard}" Padding="16,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="120"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="◈" FontSize="20" Foreground="#A98BFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="BUFF TRACKER" Style="{StaticResource SectionLabel}" FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Timers start when Land text is seen in the buff’s chosen capture region"
                               Foreground="#66879D" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource PanelActionButton}" Tag="＋" Content="Add Buff" Click="AddBuff_Click"/>
                  <Button Style="{StaticResource PanelActionButton}" Tag="✎" Content="Edit" Click="EditBuff_Click"/>
                  <Button Style="{StaticResource PanelActionButton}" Tag="🗑" Content="Delete" Click="DeleteBuff_Click"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: ACTIVE NOW -->
                <Grid Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="ACTIVE NOW" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                  <Border Grid.Row="1" Background="#61071F31" BorderBrush="#56839C" BorderThickness="1" CornerRadius="12">
                    <Grid>
                      <ListBox Name="ListActive" Background="Transparent" BorderThickness="0" Margin="4"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                  <ContentPresenter/>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border x:Name="BuffRow" BorderThickness="1" CornerRadius="10"
                                    Background="#660A2E2E" BorderBrush="#AA2EE6C8" Padding="10,8" MinHeight="44">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                             Foreground="#F0F8FF" TextTrimming="CharacterEllipsis"/>
                                  <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                               Margin="0,6,0,0" BorderThickness="0" Background="#22081420">
                                    <ProgressBar.Foreground>
                                      <SolidColorBrush Color="#A98BFF"/>
                                    </ProgressBar.Foreground>
                                  </ProgressBar>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RemainingDisplay}"
                                           FontWeight="Bold" FontSize="20" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontFamily="Segoe UI">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Foreground" Value="#A98BFF"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                          <Setter Property="Foreground" Value="#FFBD57"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                      <Setter Property="BorderBrush" Value="#FFBD57"/>
                                      <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="WarnPulse">
                                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.55" To="1" Duration="0:0:0.38"/>
                                          </Storyboard>
                                        </BeginStoryboard>
                                      </DataTrigger.EnterActions>
                                      <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="WarnPulse"/>
                                      </DataTrigger.ExitActions>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Name="TxtNoActive" Text="No tracked buffs are currently active."
                                 Foreground="#7899AD" FontSize="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Right: TRACKED BUFFS -->
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="TRACKED BUFFS" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                  <Border Grid.Row="1" Background="#9A0B263A" BorderBrush="#56839C" BorderThickness="1" CornerRadius="10,10,0,0" Padding="10,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="TRACK" Style="{StaticResource MetricLabel}"/>
                      <TextBlock Grid.Column="1" Text="BUFF NAME" Style="{StaticResource MetricLabel}"/>
                      <TextBlock Grid.Column="2" Text="DURATION" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="WARN" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="ALARM" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                  <ListBox Grid.Row="2" Name="ListBuffs" BorderThickness="1,0,1,1" BorderBrush="#56839C"
                           Background="#61071F31" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="Row" Background="#360B2638" BorderBrush="#2C4D62"
                                      BorderThickness="0,0,0,1" Padding="10,8">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Row" Property="Background" Value="#8A17354D"/>
                                  <Setter TargetName="Row" Property="BorderBrush" Value="#8F72E8"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Row" Property="Background" Value="#6916384D"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="36">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding StatusDisplay}" VerticalAlignment="Center" FontSize="11"
                                     Foreground="#39E0CC"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding WarnDisplay}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Foreground="#A9C3D3"/>
                          <TextBlock Grid.Column="4" Text="{Binding AlertDisplay}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" FontSize="10" Foreground="#7899AD"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Grid>

              <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="10" Foreground="#66879D"
                         Text="Matching is case-insensitive contains on each line’s chosen region (punctuation tolerant). Warn text alarms immediately when set."/>
            </Grid>
          </Border>
        </Grid>

        <!-- TIMER — named user countdowns + dedicated overlay -->
        <Grid Name="PanelTimers" Visibility="Collapsed">
          <Border Style="{StaticResource GlassCard}" Padding="16,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⏱" FontSize="20" Foreground="#2FD8C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="USER TIMERS" Style="{StaticResource SectionLabel}" FontSize="15"/>
                    <TextBlock Text="Named countdowns with start / stop / reset — separate overlay from buffs"
                               Foreground="#66879D" FontSize="10"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Name="BtnTimerOverlay" Style="{StaticResource HeaderActionButton}"
                          Content="Overlay: Off" Click="TimerOverlay_Click" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource PanelActionButton}" Tag="＋" Content="Add Timer" Click="AddTimer_Click"/>
                  <Button Style="{StaticResource PanelActionButton}" Tag="✎" Content="Edit" Click="EditTimer_Click"/>
                  <Button Style="{StaticResource PanelActionButton}" Tag="🗑" Content="Delete" Click="DeleteTimer_Click"/>
                </StackPanel>
              </DockPanel>

              <ListBox Grid.Row="2" Name="ListTimers" BorderBrush="#56839C" Background="#61071F31"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Row" Background="#360B2638" BorderBrush="#2C4D62"
                                  BorderThickness="0,0,0,1" Padding="12,10">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#8A17354D"/>
                              <Setter TargetName="Row" Property="BorderBrush" Value="#2FD8C7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#6916384D"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="#7899AD" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding RemainingDisplay}" FontSize="20" FontWeight="Bold"
                                 Foreground="#2FD8C7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,14,0"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start" Padding="10,6" Margin="0,0,6,0" MinWidth="64"
                                Click="TimerStart_Click" Tag="{Binding}"/>
                        <Button Content="Stop" Padding="10,6" Margin="0,0,6,0" MinWidth="64"
                                Click="TimerStop_Click" Tag="{Binding}"/>
                        <Button Content="Reset" Padding="10,6" MinWidth="64"
                                Click="TimerReset_Click" Tag="{Binding}"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- OCR — live text for every named capture region -->
        <Grid Name="PanelOcr" Visibility="Collapsed">
          <Border Style="{StaticResource GlassCard}" Padding="16,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="☰" FontSize="20" Foreground="#FF9B62" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="CAPTURE REGIONS" Style="{StaticResource SectionLabel}" FontSize="15"/>
                  <TextBlock Text="Live OCR text for every named region — manage rectangles in Options"
                             Foreground="#66879D" FontSize="10"/>
                </StackPanel>
              </StackPanel>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="ListRegionOcr">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#61071F31" BorderBrush="#56839C" BorderThickness="1"
                              CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <DockPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                         Foreground="#F0F8FF" TextTrimming="CharacterEllipsis"/>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding StatusDisplay}"
                                         FontSize="11" Foreground="#39E0CC" Margin="12,0,0,0"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding BoundsDisplay}" FontSize="10" Foreground="#66879D" Margin="0,2,0,0"/>
                          </StackPanel>
                          <TextBox IsReadOnly="True" Text="{Binding Text, Mode=OneWay}"
                                   TextWrapping="Wrap" AcceptsReturn="True"
                                   VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="220"
                                   FontFamily="Consolas" FontSize="11"
                                   Background="#33081420" BorderBrush="#3D6178"
                                   Foreground="#B8D4E5" CaretBrush="#A98BFF"/>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- DAMAGE TRACKER — personal outgoing / incoming only -->
        <Grid Name="PanelDamage" Visibility="Collapsed">
          <Border Style="{StaticResource GlassCard}" Padding="16,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="⚔" FontSize="20" Foreground="#A98BFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="DAMAGE TRACKER" Style="{StaticResource SectionLabel}" FontSize="15"/>
                    <TextBlock Text="Damage you deal and damage dealt to you. Other players are not counted."
                               Foreground="#66879D" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PanelActionButton}" Content="Reset"
                        VerticalAlignment="Center" Click="ResetDamage_Click"/>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock Text="DAMAGE WINDOW" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                  <ComboBox Name="CmbDamageRegion" DisplayMemberPath="Name"
                            Foreground="#EDF7FF" Background="#A0092235" BorderBrush="#42677F"
                            SelectionChanged="DamageRegion_Changed"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Name="TxtDamageHint" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           Foreground="#7899AD" FontSize="11" Margin="0,0,0,6"/>
              </Grid>

              <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#61071F31" BorderBrush="#39E0CC" BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="OUTGOING" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Name="TxtOutTotal" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="#39E0CC"/>
                    <TextBlock Name="TxtOutHits" Text="0 hits" Foreground="#8FDCD9" FontSize="11"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#61071F31" BorderBrush="#FF8B7A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="INCOMING" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Name="TxtInTotal" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="#FF8B7A"/>
                    <TextBlock Name="TxtInHits" Text="0 hits" Foreground="#E7B2AA" FontSize="11"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="LIVE HITS" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="#9A0B263A" BorderBrush="#56839C" BorderThickness="1" CornerRadius="10,10,0,0" Padding="10,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="78"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TIME" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Grid.Column="1" Text="DIR" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="WHO" Style="{StaticResource MetricLabel}" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
                <Border Grid.Row="2" Background="#61071F31" BorderBrush="#56839C" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12">
                  <Grid>
                    <ListBox Name="ListDamage" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Focusable" Value="False"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="#360B2638" BorderBrush="#2C4D62" BorderThickness="0,0,0,1" Padding="10,7">
                                  <ContentPresenter/>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid MinHeight="28">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="78"/>
                              <ColumnDefinition Width="52"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeDisplay}" VerticalAlignment="Center" Foreground="#8FB4C6" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding DirectionDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#FF8B7A"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outgoing}" Value="True">
                                      <Setter Property="Foreground" Value="#39E0CC"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F0F8FF"/>
                            <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="#F0F8FF"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#66879D"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Name="TxtNoDamage" Text="No new hits yet. Lines already on screen when tracking starts are ignored."
                               Foreground="#7899AD" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
