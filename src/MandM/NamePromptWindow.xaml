<Window x:Class="MandM.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF061522">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Name="TxtPrompt" Style="{StaticResource DialogLabel}" TextWrapping="Wrap"/>
      <TextBox Name="TxtName" MinHeight="34" Margin="0,4,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
